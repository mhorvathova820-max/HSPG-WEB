# Ukázková konfigurace pro lokální nasazení. Nikdy nevkládejte skutečné klíče do Gitu.
# Proměnné externích poskytovatelů jsou pouze připravené; integrace zatím nejsou zapojeny.

# Tajný klíč API Anthropic/Claude. Získávejte a spravujte pouze v oficiálním konzolovém účtu.
ANTHROPIC_API_KEY=
# Přesný model povolený ve vašem účtu Anthropic; prázdná hodnota vypíná agentní požadavky.
ANTHROPIC_MODEL=

# Přístupový token a základní URL e-podpisové služby DigiSign.
# BankID ani DigiSign nejsou v současné aplikaci implementovány.
DIGISIGN_API_TOKEN=
DIGISIGN_API_URL=

# Přístup pro Meta Marketing API a identifikátor reklamního účtu.
# Aplikace kampaně pouze připravuje jako návrhy a nic do Meta neodesílá.
META_MARKETING_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Identifikátor zákaznického účtu Google Ads a vývojářský token.
# Google Ads API není v současné aplikaci implementováno.
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=

# Tajný klíč pro ověření externě vydaných administrátorských JWT (min. 32 bajtů).
# Generujte jej kryptograficky bezpečně a uchovávejte pouze v secret manageru / .env.
# Aplikace tokeny nevydává; JWT musí mít iss=holub360, aud=holub360-admin,
# role=admin, sub a neexpirovaný exp. Při prázdné hodnotě jsou admin API vypnutá.
ADMIN_JWT_SECRET=

# Volitelná důvěryhodná IP adresa nebo seznam IP reverzních proxy oddělených čárkou.
# Nastavte pouze na přesné proxy, které provozovatel spravuje; jinak ponechte prázdné.
TRUSTED_PROXY_IPS=

# Port HTTP serveru; pokud není nastaven, aplikace použije 3000.
PORT=3000
